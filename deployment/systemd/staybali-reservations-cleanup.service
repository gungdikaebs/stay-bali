[Unit]
Description=StayBali expired reservation cleanup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=staybali
Group=staybali
WorkingDirectory=/srv/staybali/current
EnvironmentFile=/etc/staybali/staybali.env
ExecStart=/usr/bin/npm run reservations:cleanup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/staybali/shared

[Install]
WantedBy=multi-user.target
